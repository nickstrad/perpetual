# Local settings matching `make dev-db-up`. Export them before running the service,
# or use `eval "$(make -s dev-db-env)"` for a checkout-local runtime directory.
PERPETUAL_API_URL=http://127.0.0.1:7777
PERPETUAL_LISTEN_ADDRESS=127.0.0.1:7777
PERPETUAL_DATABASE_URL=postgres://perpetual:perpetual-local@127.0.0.1:54329/perpetual?sslmode=disable
PERPETUAL_RUNTIME_DIR=/run/perpetual
PERPETUAL_MAX_REGISTRATIONS=1024
